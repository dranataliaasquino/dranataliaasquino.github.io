---
import { SITE, CONTACT, LOCATIONS, NAV, whatsappLink, mailtoLink } from '../site.config';
const year = new Date().getFullYear();
---

<footer class="border-t border-sage-100">
  <div class="mx-auto max-w-6xl px-5 lg:px-8 py-12">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-[repeat(24,minmax(0,1fr))] lg:gap-8">
      <div class="lg:col-span-6">
        <div class="font-serif text-xl text-sage-900">{SITE.name}</div>
        <p class="text-[14px] text-muted mt-2 leading-relaxed">{SITE.tagline}</p>
      </div>

      <div class="lg:col-start-8 lg:col-span-4">
        <h4 class="text-[13px] uppercase tracking-wider text-sage-600 font-medium mb-3">Navegación</h4>
        <ul class="space-y-2 text-[14px]">
          {
            NAV.filter((item) => item.href !== '/' && item.href !== '/contacto/').map((item) => (
              <li>
                <a href={item.href} class="text-sage-900 hover:text-sage-600">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="lg:col-start-13 lg:col-span-6">
        <h4 class="text-[13px] uppercase tracking-wider text-sage-600 font-medium mb-3">Consultorios</h4>
        <ul class="space-y-3">
          {
            LOCATIONS.map((loc) => (
              <li class="text-[14px] text-sage-900">
                <div class="font-medium">{loc.name}</div>
                <div class="text-muted">{loc.address}</div>
                <div class="text-muted">{loc.addressLine2}</div>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="lg:col-start-20 lg:col-span-6">
        <h4 class="text-[13px] uppercase tracking-wider text-sage-600 font-medium mb-3">Contacto</h4>
        <ul class="space-y-2 text-[14px]">
          <li>
            <a href={mailtoLink()} class="text-sage-900 hover:text-sage-600">
              {CONTACT.email}
            </a>
          </li>
          <li>
            <a href={whatsappLink()} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 text-sage-900 hover:text-sage-600">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 text-[#25D366]">
                <path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 018.413 3.488 11.824 11.824 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
              </svg>
              {CONTACT.whatsapp.display}
            </a>
          </li>
          <li>
            <a href="/privacidad/" class="text-muted hover:text-sage-600 text-[13px]">
              Aviso de privacidad
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-10 pt-6 border-t border-sage-100/80 flex flex-col sm:flex-row justify-between gap-3 text-[12px] text-muted">
      <div>© {year} {SITE.name}. Todos los derechos reservados.</div>
    </div>
  </div>
</footer>
