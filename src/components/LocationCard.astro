---
interface Props {
  location: {
    id: string;
    name: string;
    address: string;
    addressLine2: string;
    fullAddress: string;
    hours: string;
    mapsLink: string;
  };
  showMap?: boolean;
}

const { location, showMap = false } = Astro.props;
---

<div class="bg-white border border-sage-100 rounded-lg overflow-hidden">
  {
    showMap && (
      <div class="aspect-[16/9] bg-sage-100/40">
        <iframe
          title={`Mapa - ${location.name}`}
          src={`https://maps.google.com/maps?q=${encodeURIComponent(location.fullAddress)}&output=embed`}
          width="100%"
          height="100%"
          style="border:0;"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        />
      </div>
    )
  }
  <div class="p-6">
    <h3 class="text-xl font-serif text-sage-900 mb-2">{location.name}</h3>
    <div class="text-[14px] text-sage-900 mb-1">{location.address}</div>
    <div class="text-[14px] text-muted mb-4">{location.addressLine2}</div>

    <div class="text-[13px] uppercase tracking-wider text-sage-600 font-medium mb-1 mt-4">Horarios</div>
    <div class="text-[14px] text-sage-900 mb-4">{location.hours}</div>

    <a
      href={location.mapsLink}
      target="_blank"
      rel="noopener"
      class="inline-flex items-center gap-1 text-[13px] text-sage-600 hover:text-sage-900 underline underline-offset-4"
    >
      Ver en Google Maps →
    </a>
  </div>
</div>
