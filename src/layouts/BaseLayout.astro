---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, LOCATIONS, CONTACT, LIVE } from '../site.config';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title = SITE.name,
  description = SITE.description,
  image = '/og-image.png',
  noindex = false,
} = Astro.props;

const pageTitle = title === SITE.name ? title : `${title} · ${SITE.shortName}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();

// Structured data: MedicalOrganization (parent brand) + 2 LocalBusiness departments.
// This pattern is Google's recommended schema for multi-location businesses — each
// consultorio can rank independently in its own local search area while sharing the
// parent brand identity.
// Nota: `sameAs` (IG/FB) se omite a propósito mientras los perfiles
// estén incompletos. Reactivar cuando IG y FB tengan contenido publicable.
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'MedicalOrganization',
  '@id': `${SITE.url}/#organization`,
  name: SITE.name,
  description: SITE.description,
  url: SITE.url,
  logo: `${SITE.url}/images/logo.svg`,
  image: `${SITE.url}/images/equipo.jpg`,
  medicalSpecialty: 'Periodontics',
  department: LOCATIONS.map((loc) => ({
    '@type': ['Dentist', 'MedicalBusiness'],
    '@id': `${SITE.url}/#consultorio-${loc.id}`,
    name: `${SITE.name} — ${loc.name}`,
    url: `${SITE.url}/consultorios/#${loc.id}`,
    image: `${SITE.url}/images/equipo.jpg`,
    telephone: CONTACT.whatsapp.number,
    email: CONTACT.email,
    medicalSpecialty: 'Periodontics',
    address: {
      '@type': 'PostalAddress',
      streetAddress: loc.address,
      addressLocality: loc.name,
      addressRegion: loc.region,
      postalCode: loc.postalCode,
      addressCountry: loc.countryCode,
    },
    geo: {
      '@type': 'GeoCoordinates',
      latitude: loc.geo.latitude,
      longitude: loc.geo.longitude,
    },
    openingHours: loc.openingHoursSchema,
    hasMap: loc.mapsLink,
    areaServed: loc.id === 'punta-del-este' ? ['Punta del Este', 'Maldonado'] : loc.name,
  })),
};
---

<!doctype html>
<html lang="es-UY">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {(!LIVE || noindex) && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="es_UY" />
    <meta property="og:image" content={new URL(image, Astro.site).toString()} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="Dra. Natalia Asquino · Periodoncia" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site).toString()} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 bg-sage-900 text-cream px-3 py-2 rounded">
      Saltar al contenido
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
