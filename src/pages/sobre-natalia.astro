---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import { SITE } from '../site.config';

// ProfilePage with a Person as mainEntity. Google recognizes ProfilePage as
// a rich result feature (added 2024) for pages that profile a single person.
// The Person entity inside carries all the credentials, affiliations and
// expertise — necessary (though not sufficient) for an eventual personal
// Knowledge Panel and for being referenced as the author of blog articles
// (Article schemas link back to the Person @id below).
// sameAs (IG / FB profiles) is intentionally omitted while those profiles
// are still being populated. Reactivate once they have publishable content.
const profileSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  '@id': `${SITE.url}/sobre-natalia/#profilepage`,
  url: `${SITE.url}/sobre-natalia/`,
  dateCreated: '2026-05-02',
  mainEntity: {
    '@type': 'Person',
    '@id': `${SITE.url}/sobre-natalia/#person`,
    name: 'Natalia Asquino',
    givenName: 'Natalia',
    familyName: 'Asquino',
    honorificPrefix: 'Dra.',
    jobTitle: 'Periodoncista',
    description:
      'Doctora en Odontología y especialista en Periodoncia con más de 10 años de práctica clínica. Profesora Adjunta (Grado 3) de la Cátedra de Periodoncia, Facultad de Odontología, UdelaR. Líneas de investigación en cirugía plástica periodontal y dolor postoperatorio en injertos periodontales.',
    image: `${SITE.url}/images/natalia-asquino.jpg`,
    url: `${SITE.url}/sobre-natalia/`,
    worksFor: {
      '@type': 'MedicalOrganization',
      '@id': `${SITE.url}/#organization`,
      name: SITE.name,
      url: SITE.url,
    },
    alumniOf: [
      {
        '@type': 'CollegeOrUniversity',
        name: 'Universidad de la República (UdelaR)',
        url: 'https://udelar.edu.uy',
      },
    ],
    affiliation: {
      '@type': 'EducationalOrganization',
      name: 'Facultad de Odontología, UdelaR',
      url: 'https://odon.edu.uy',
    },
    hasOccupation: {
      '@type': 'Occupation',
      name: 'Periodoncista',
      description: 'Especialista en periodoncia, cirugía mucogingival e implantes dentales',
      occupationLocation: [
        { '@type': 'City', name: 'Montevideo' },
        { '@type': 'City', name: 'Punta del Este' },
      ],
    },
    knowsAbout: [
      'Periodoncia',
      'Cirugía mucogingival',
      'Recubrimiento radicular',
      'Regeneración tisular',
      'Implantología',
      'Tratamiento de recesiones gingivales',
      'Mantenimiento periodontal',
      'Dolor postoperatorio en cirugía periodontal',
    ],
  },
};
---

<BaseLayout
  title="Sobre Natalia"
  description="Conocé a la Dra. Natalia Asquino, periodoncista con consulta en Montevideo y Punta del Este."
>
  <Section padding="lg" width="default">
    <p class="text-[13px] uppercase tracking-[0.18em] text-sage-600 mb-3">Sobre Natalia</p>
    <h1 class="text-4xl lg:text-5xl font-serif text-sage-900 mb-6">
      Periodoncia con foco en el cuidado a largo plazo
    </h1>

    <div class="grid lg:grid-cols-4 gap-10">
      <div class="lg:col-span-1">
        <img
          src="/images/natalia-asquino.jpg"
          alt="Dra. Natalia Asquino, periodoncista"
          class="aspect-[3/4] lg:aspect-auto w-full lg:h-full object-cover object-[center_20%] rounded-lg border border-sage-100"
          loading="eager"
        />
      </div>

      <div class="prose-body lg:col-span-3">
        <p>
          Soy doctora en odontología y especialista en periodoncia, con más de 10 años de práctica clínica y experiencia en casos de alta complejidad.
        </p>
        <p>
          Mi práctica clínica se concentra en el diagnóstico, tratamiento y mantenimiento de las
          enfermedades periodontales y periimplantarias. Realizo también colocación y rehabilitación
          de implantes cuando el plan de tratamiento lo requiere, siempre integrada al manejo
          periodontal integral del paciente.
        </p>
        <p>
          Atiendo en dos sedes: Montevideo, donde está mi consultorio principal, y Punta del Este,
          donde acudo de forma regular. Trabajo con un equipo de profesionales que comparten un
          mismo enfoque: atención cuidadosa, basada en evidencia y orientada a la salud bucal a
          largo plazo del paciente.
        </p>
        <p>
          En el ámbito académico, soy profesora adjunta (Grado 3) de la Cátedra de Periodoncia de la
          Facultad de Odontología, UdelaR, con desempeño en grado y posgrado. He publicado
          trabajos en revistas académicas arbitradas y especializadas, y presentado en
          congresos nacionales e internacionales de periodoncia. La combinación entre práctica
          clínica, docencia e investigación me permite mantener actualizados los protocolos
          que aplico en consulta.
        </p>
      </div>
    </div>

    <div class="prose-body mt-12">
      <h2>Formación</h2>
      <ul>
        <li>Doctora en Odontología — Facultad de Odontología, UdelaR</li>
        <li>Especialista en Periodoncia — Facultad de Odontología, UdelaR</li>
        <li>Maestría en Ciencias Médicas — Facultad de Medicina, UdelaR</li>
        <li>Profesora Adjunta (Grado 3), Cátedra de Periodoncia, UdelaR — grado y posgrado</li>
      </ul>

      <h2>Áreas de interés clínico</h2>
      <ul>
        <li>Tratamiento de la enfermedad periodontal</li>
        <li>Cirugía mucogingival y recubrimiento radicular</li>
        <li>Regeneración tisular</li>
        <li>Implantología y manejo de complicaciones periimplantarias</li>
        <li>Mantenimiento periodontal e higiene profesional</li>
      </ul>

      <p class="mt-10 text-[14px] text-muted">
        ¿Querés ver el detalle académico? <a href="/cv/">Currículum completo →</a>
      </p>
    </div>
  </Section>

  <!-- ProfilePage structured data with Person as mainEntity -->
  <script type="application/ld+json" set:html={JSON.stringify(profileSchema)} />
</BaseLayout>
