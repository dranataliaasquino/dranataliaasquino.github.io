---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
---

<BaseLayout
  title="Casos clínicos"
  description="Galería de casos clínicos de periodoncia e implantología tratados en consulta."
  noindex={true}
>
  <Section padding="lg" width="default">
    <p class="text-[13px] uppercase tracking-[0.18em] text-sage-600 mb-3">Casos clínicos</p>
    <h1 class="text-4xl lg:text-5xl font-serif text-sage-900 mb-6">Antes y después</h1>
    <p class="text-muted mb-12 text-justify">
      Selección de casos representativos del trabajo en consulta.
    </p>

    <div class="bg-white border border-sage-100 rounded-lg p-8 text-center">
      <p class="text-muted text-[14px]">
        Sección en preparación. Los primeros casos se publicarán próximamente.
      </p>
    </div>
  </Section>
</BaseLayout>
