---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
---

<BaseLayout
  title="Investigación y docencia"
  description="Actividad académica, publicaciones y proyectos de investigación de la Dra. Natalia Asquino."
>
  <Section padding="lg" width="default">
    <p class="text-[13px] uppercase tracking-[0.18em] text-sage-600 mb-3">Investigación y docencia</p>
    <h1 class="text-4xl lg:text-5xl font-serif text-sage-900 mb-6">Actividad académica</h1>

    <div class="prose-body">
      <h2>Publicaciones</h2>
      <p class="text-muted">[Pendiente: lista de publicaciones con enlace o PDF.]</p>

      <h2>Proyectos en curso</h2>
      <p class="text-muted">[Pendiente: descripción breve de líneas de investigación activas.]</p>

      <h2>Docencia</h2>
      <p class="text-muted">[Pendiente: cursos, materias y formación clínica.]</p>
    </div>
  </Section>
</BaseLayout>
